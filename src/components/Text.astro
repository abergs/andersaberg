---

<div>
    <div id="scene" style=""></div>
    <div id="canvas" style="display:none;"></div>

    <script is:inline src="./leon.js"></script>
    <script is:inline src="/matter.min.js"></script>
</div>

<script>
    import { Application, Graphics, Container } from "pixi.js";

    let leon, ctx, scene, engine: Matter.Engine, app: Application;
    const circlesContainer = new Container();
    const sw = window.innerWidth;
    const sh = window.innerHeight;
    // Text is sized and centred based on a content width cap
    const contentW = Math.min(window.innerWidth, 800) - 80;
    const textX = Math.round((sw - contentW) / 2);
    const FLOOR_SEGS = 30;
    const FLOOR_BEND_AMPLITUDE = 70;
    const floorBaseY = Math.round(sh * 0.5);
    let sceneObjects = [];
    let elapsedMs = 0.0;
    let floorSegments: { body: Matter.Body; visual: any; baseX: number; baseY: number }[] = [];
    let targetBend = 0;   // -1 to 1
    let currentBend = 0;

    let text = {
        leon: null as any,
        graphics: null as Graphics,
    };

    // module aliases
    let Engine = Matter.Engine,
        Render = Matter.Render,
        Runner = Matter.Runner,
        Bodies = Matter.Bodies,
        World = Matter.World,
        Composite = Matter.Composite;

    //settings.RESOLUTION = window.devicePixelRatio;

    function init() {
        scene = document.getElementById("scene");
        scene.width = sw;
        scene.height = sh;
        scene.style.width = sw + "px";
        scene.style.height = sh + "px";

        // Setup Pixi renderer to match the same size as the Matter world.
        app = new Application({
            backgroundAlpha: 0,
            resizeTo: scene,
            antialias: true,
            resolution: window.devicePixelRatio || 1,
            autoDensity: true,
        });
        scene.appendChild(app.view);

        // Matter engine
        engine = Engine.create({ enableSleeping: false });

        // Leon Sans
        text = {
            leon: new LeonSans({
                text: "ANDERS ÅBERG",
                color: ["#000000"],
                size: contentW / 8.5,
                weight: 450,
                isPath: true,
                tracking: 1,
            }),
            graphics: new Graphics(),
        };
        const fontSize = contentW / 8.5;
        text.leon.position(textX, floorBaseY - fontSize - 20);
        app.stage.addChild(text.graphics);

        // add the circles container
        app.stage.addChild(circlesContainer);

        // Floor
        createFloor();

        // Build continuous letter surfaces using thin rectangle segments between
        // adjacent path points. This eliminates the gaps that caused jankiness
        // when using circles at discrete path points.
        const pathPoints = text.leon.paths;
        for (let i = 0; i < pathPoints.length - 1; i++) {
            const p1 = pathPoints[i];
            const p2 = pathPoints[i + 1];

            const dx = p2.x - p1.x;
            const dy = p2.y - p1.y;
            const dist = Math.sqrt(dx * dx + dy * dy);

            // Skip if points are too far apart — they belong to different strokes
            // or different letters and should not be connected.
            if (dist > 25) continue;

            const angle = Math.atan2(dy, dx);
            const mx = (p1.x + p2.x) / 2;
            const my = (p1.y + p2.y) / 2;

            const segBody = Bodies.rectangle(mx, my, dist + 1, 8, {
                isStatic: true,
                angle: angle,
                label: "leon",
                friction: 0.3,
                restitution: 0.1,
                frictionStatic: 0.1,
            });
            World.addBody(engine.world, segBody);
        }

        // create runner
        var runner = Runner.create();
        // run the engine
        Runner.run(runner, engine);

        text.leon.drawPixi(text.graphics);

        // Tilt floor toward mouse/touch position
        const canvas = app.view as HTMLCanvasElement;
        const updateBend = (clientX: number) => {
            // Normalise relative to the content area (not full viewport)
            const t = Math.max(0, Math.min(1, (clientX - textX) / contentW));
            targetBend = Math.max(-1, Math.min(1, (t - 0.5) * 4));
        };
        window.addEventListener('mousemove', (e) => updateBend(e.clientX));
        window.addEventListener('touchmove', (e) => updateBend(e.touches[0].clientX), { passive: true });

        let elapsed = 0.0;
        let sinceMs = 0.0;
        app.ticker.add((delta) => {
            elapsed += delta;
            elapsedMs += app.ticker.deltaMS;
            sinceMs += app.ticker.deltaMS;

            // Bend floor smoothly toward target
            currentBend += (targetBend - currentBend) * 0.04;

            floorSegments.forEach((seg, i) => {
                const x = (i + 0.5) / FLOOR_SEGS; // 0..1

                // Cubic droop: only the active edge bends downward.
                // bend > 0 → right edge droops  (mouse right → balls fall right)
                // bend < 0 → left edge droops   (mouse left  → balls fall left)
                let yOffset: number;
                let slope: number;
                if (currentBend >= 0) {
                    yOffset = FLOOR_BEND_AMPLITUDE * currentBend * Math.pow(x, 3);
                    slope   = FLOOR_BEND_AMPLITUDE * currentBend * 3 * Math.pow(x, 2) / contentW;
                } else {
                    const nb = -currentBend;
                    yOffset = FLOOR_BEND_AMPLITUDE * nb * Math.pow(1 - x, 3);
                    slope   = -FLOOR_BEND_AMPLITUDE * nb * 3 * Math.pow(1 - x, 2) / contentW;
                }

                const newY = seg.baseY + yOffset;
                const angle = Math.atan(slope);
                Matter.Body.setPosition(seg.body, { x: seg.baseX, y: newY });
                Matter.Body.setAngle(seg.body, angle);
                seg.visual.y = newY;
                seg.visual.rotation = angle;
            });

            // Remove stuck or out-of-bounds balls
            sceneObjects = sceneObjects.filter((object) => {
                const vel = object.body.velocity;
                const speed = Math.sqrt(vel.x * vel.x + vel.y * vel.y);
                const stuckMs = elapsedMs - object.lastMovedMs;

                if (speed > 0.3) object.lastMovedMs = elapsedMs;

                const isStuck = stuckMs > 1500;
                const isOutOfBounds = object.body.position.y > sh + 50;

                if (isStuck || isOutOfBounds) {
                    Matter.Composite.remove(engine.world, object.body);
                    circlesContainer.removeChild(object.sprite);
                    return false;
                }
                return true;
            });

            sceneObjects.forEach((object) => {
                let x = object.body.position.x;
                let y = object.body.position.y;

                // update position
                object.sprite.position.x = x - object.init.x;
                object.sprite.position.y = y - object.init.y;
            });

            // Spawn a new ball every 100ms
            if (sinceMs > 100) {
                sinceMs = 0;
                if (sceneObjects.length < 90) {
                    createSceneObject({
                        init: {
                            x: 10 + Math.floor(Math.random() * sw),
                            y: 10,
                        },
                        radius: 2 + Math.floor(Math.random() * 5),
                        label: "circle",
                    });
                }
            }

            Matter.Engine.update(engine, 1000 / 60);
        });

        for (let i = 0; i < 1; i++) {
            createSceneObject({
                init: {
                    x: 90,
                    y: 10,
                },
                radius: 4,
                label: "circle",
            });
        }

        //debugRenderer();
    }

    function debugRenderer() {
        var render = Render.create({
            element: document.getElementById("canvas"),
            engine: engine,
            options: {
                width: sw,
                height: sh,
                pixelRatio: window.devicePixelRatio,
            },
        });
        Render.run(render);
    }

    function createFloor() {
        const floorY = floorBaseY;
        const segW = contentW / FLOOR_SEGS;

        for (let i = 0; i < FLOOR_SEGS; i++) {
            const xPx = textX + (i + 0.5) * segW;

            const body = Bodies.rectangle(xPx, floorY, segW + 2, 6, { isStatic: true });
            World.addBody(engine.world, body);

            // Draw centred at local (0,0) so rotation pivots correctly
            const g = new Graphics();
            g.beginFill(0x000000);
            g.drawRect(-segW / 2 - 1, -1, segW + 2, 2);
            g.endFill();
            g.x = xPx;
            g.y = floorY;
            g.zIndex = 100;
            app.stage.addChild(g);

            floorSegments.push({ body, visual: g, baseX: xPx, baseY: floorY });
        }
    }

    function createSceneObject(obj) {
        // Matter Body

        const allProps = [
            {
                color: 0xffffff,
                restitution: 0.3,
            },
            {
                color: 0x2596be,
                restitution: 0.3,
            },
            {
                color: 0xf1c95a,
                restitution: 0.3,
            },
            {
                color: 0xee0000,
                restitution: 0.9,
            },
            {
                color: 0x0000ee,
                restitution: 0.7,
            },
        ];

        const props = allProps[Math.floor(Math.random() * allProps.length)];

        const circleBody = Bodies.circle(obj.init.x, obj.init.y, obj.radius, {
            restitution: props.restitution,
            isStatic: obj.isStatic,
            label: obj.label,
            frictionAir: 0.03,
        });
        World.addBody(engine.world, circleBody);

        //
        let template = new Graphics();
        template.lineStyle(1, props.color);
        template.beginFill(props.color);
        template.drawCircle(obj.init.x, obj.init.y, obj.radius);
        template.endFill();
        template.zIndex = 10;
        circlesContainer.addChild(template);

        // Add the complete scene object (body and sprite) to our array of objects. We'll track those objects in the pixi frame updates (see app.ticker below).
        sceneObjects.push({
            body: circleBody,
            sprite: template,
            init: obj.init,
            lastMovedMs: elapsedMs,
        });
    }

    window.onload = () => {
        init();
    };
</script>
